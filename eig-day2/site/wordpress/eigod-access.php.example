<?php
/**
 * Plugin Name: EIG On-Demand Access
 * Description: Lifetime access to the Day 2 On-Demand library. Verifies Stripe Checkout Sessions, sets a signed
 *              HttpOnly cookie, renews it on every visit, lets buyers restore access on any device by email, and
 *              signs in partners who use the one shared partner link.
 *              Install as wp-content/mu-plugins/eigod-access.php   (the gating kit puts it there for you)
 *
 * All settings live in ONE file above the web root: /home/<account>/eigod-config.php (see eigod-config.php.example).
 *
 * Lifetime access, in practice: browsers cap any cookie at about 400 days, so the cookie is renewed silently
 * on every visit (/refresh), and a buyer on a new device, or after clearing cookies, restores access with the
 * email they paid with (/restore sends a one-time link checked against Stripe, /redeem signs them in).
 *
 * Partners: one shared link, <watch page>/?partner=<partner_key>. Anyone with the link is signed in for good.
 * To shut it off for everyone (including browsers already signed in), change partner_key in the config file
 * (or set it to '' to switch partner access off); the old link and every partner cookie stop working at once.
 */

if (!defined('ABSPATH')) exit;

/** a setting from /home/<account>/eigod-config.php (the folder above public_html), or $default */
function eigod_conf($key, $default = null) {
    static $c = null;
    if ($c === null) {
        $f = defined('EIGOD_CONFIG_FILE') ? EIGOD_CONFIG_FILE : dirname(rtrim(ABSPATH, '/\\')) . '/eigod-config.php';
        $c = is_file($f) ? (array) include $f : array();
    }
    return array_key_exists($key, $c) ? $c[$key] : $default;
}

const EIGOD_COOKIE = 'eigod_access';
const EIGOD_DAYS   = 400;     // browser maximum; renewed on every visit, so access never lapses
const EIGOD_LINK_MINUTES = 30; // restore links expire after this

function eigod_secret() { return (string) eigod_conf('secret', ''); }
function eigod_b64($s) { return rtrim(strtr(base64_encode($s), '+/', '-_'), '='); }
function eigod_unb64($s) { return base64_decode(strtr($s, '-_', '+/')); }
function eigod_email_hash($email) { return substr(hash('sha256', strtolower(trim($email))), 0, 16); }

/** access token = base64url(expiry.emailhash) . '.' . hmac   (the video gate checks the same format) */
function eigod_make_token($email_hash, $expires) {
    $payload = eigod_b64($expires . '.' . $email_hash);
    return $payload . '.' . hash_hmac('sha256', $payload, eigod_secret());
}
/** returns the email hash inside a valid, unexpired token, or false */
function eigod_read_token($tok, $prefix = '') {
    $parts = explode('.', (string) $tok);
    if (count($parts) !== 2 || !eigod_secret()) return false;
    list($payload, $sig) = $parts;
    if (!hash_equals(hash_hmac('sha256', $prefix . $payload, eigod_secret()), $sig)) return false;
    $bits = explode('.', eigod_unb64($payload));
    if (count($bits) !== 2 || (int) $bits[0] < time()) return false;
    return $bits[1];
}
/** the id stored in a partner's cookie; starts with 'p' so it can't collide with a buyer's (hex) id. It changes
 *  whenever partner_key changes, which is what ends every partner session. False when partner access is off. */
function eigod_partner_hash() {
    $k = (string) eigod_conf('partner_key', '');
    return $k === '' ? false : 'p' . substr(hash('sha256', 'partner:' . $k), 0, 15);
}
function eigod_grant($email_hash) {
    $expires = time() + EIGOD_DAYS * DAY_IN_SECONDS;
    $opts    = array('expires' => $expires, 'path' => '/', 'secure' => true, 'samesite' => 'Lax');
    setcookie(EIGOD_COOKIE, eigod_make_token($email_hash, $expires), $opts + array('httponly' => true));
    setcookie('eigod_ok', '1', $opts + array('httponly' => false)); // lets the page know to show the library
}
function eigod_stripe($path) {
    $key = (string) eigod_conf('stripe_secret_key', '');
    if ($key === '' || strpos($key, 'PASTE') !== false) return null;
    $res = wp_remote_get('https://api.stripe.com/v1/' . $path, array(
        'headers' => array('Authorization' => 'Bearer ' . $key), 'timeout' => 15));
    if (is_wp_error($res) || wp_remote_retrieve_response_code($res) !== 200) return null;
    return json_decode(wp_remote_retrieve_body($res), true);
}
function eigod_session_ok($s) {
    $paid = isset($s['payment_status']) && $s['payment_status'] === 'paid';
    $id   = (string) eigod_conf('stripe_link_id', '');   // only count purchases made through THIS Payment Link
    $link = $id === '' || (isset($s['payment_link']) && $s['payment_link'] === $id);
    return $paid && $link;
}
function eigod_reply($ok, $code = 200) { return new WP_REST_Response(array('ok' => (bool) $ok), $code); }

add_action('rest_api_init', function () {
    // 1. Back from Stripe Checkout: verify the session server-side, then grant access.
    register_rest_route('eigod/v1', '/verify', array('methods' => 'GET', 'permission_callback' => '__return_true',
        'callback' => function (WP_REST_Request $req) {
            $sid = sanitize_text_field($req->get_param('session_id'));
            if (!preg_match('/^cs_(test|live)_[A-Za-z0-9]+$/', $sid) || !eigod_secret()) return eigod_reply(false, 400);
            $s = eigod_stripe('checkout/sessions/' . rawurlencode($sid));
            if (!$s || !eigod_session_ok($s)) return eigod_reply(false, 402);
            $email = isset($s['customer_details']['email']) ? $s['customer_details']['email'] : $sid;
            eigod_grant(eigod_email_hash($email));
            return eigod_reply(true);
        }));

    // 2. Every visit to the watch page: push the cookie's expiry forward again.
    register_rest_route('eigod/v1', '/refresh', array('methods' => 'GET', 'permission_callback' => '__return_true',
        'callback' => function () {
            $h = eigod_read_token(isset($_COOKIE[EIGOD_COOKIE]) ? $_COOKIE[EIGOD_COOKIE] : '');
            if (!$h) return eigod_reply(false, 401);
            if ($h[0] === 'p' && $h !== eigod_partner_hash()) return eigod_reply(false, 401); // partner key changed or switched off
            eigod_grant($h);
            return eigod_reply(true);
        }));

    // 2b. The shared partner link: right key -> sign this browser in (no purchase).
    register_rest_route('eigod/v1', '/partner', array('methods' => 'GET', 'permission_callback' => '__return_true',
        'callback' => function (WP_REST_Request $req) {
            $ph  = eigod_partner_hash();
            $key = (string) $req->get_param('key');
            if (!$ph || !eigod_secret() || !hash_equals((string) eigod_conf('partner_key'), $key)) return eigod_reply(false, 401);
            eigod_grant($ph);
            return eigod_reply(true);
        }));

    // 3. "Restore access": email a one-time sign-in link if this email has a paid pass.
    //    Always answers the same way, so it can't be used to discover who bought.
    register_rest_route('eigod/v1', '/restore', array('methods' => 'POST', 'permission_callback' => '__return_true',
        'callback' => function (WP_REST_Request $req) {
            $email = sanitize_email($req->get_param('email'));
            $back  = esc_url_raw($req->get_param('back'));
            $ip    = 'eigod_rl_' . md5(isset($_SERVER['REMOTE_ADDR']) ? $_SERVER['REMOTE_ADDR'] : '');
            $tries = (int) get_transient($ip);
            if ($tries >= 5) return eigod_reply(true);               // quietly rate-limited: 5 per hour per IP
            set_transient($ip, $tries + 1, HOUR_IN_SECONDS);
            if (!is_email($email) || !eigod_secret() || strpos($back, home_url()) !== 0) return eigod_reply(true);
            $q = 'checkout/sessions?limit=20&status=complete&customer_details[email]=' . rawurlencode($email)
               . (eigod_conf('stripe_link_id') ? '&payment_link=' . rawurlencode(eigod_conf('stripe_link_id')) : '');
            $list = eigod_stripe($q);
            $found = false;
            foreach (($list && isset($list['data'])) ? $list['data'] : array() as $s) { if (eigod_session_ok($s)) { $found = true; break; } }
            if ($found) {
                $payload = eigod_b64((time() + EIGOD_LINK_MINUTES * 60) . '.' . eigod_email_hash($email));
                $link    = add_query_arg('restore', $payload . '.' . hash_hmac('sha256', 'r' . $payload, eigod_secret()), $back);
                wp_mail($email, 'Your Day 2 On-Demand sign-in link',
                    "Here is your link to the EIG Innovation Conference Day 2 On-Demand library:\n\n$link\n\n"
                    . "It works once and expires in " . EIGOD_LINK_MINUTES . " minutes. If you didn't ask for it, ignore this email.");
            }
            return eigod_reply(true);
        }));

    // 4. The emailed link lands on the watch page, which calls this to sign the browser in.
    register_rest_route('eigod/v1', '/redeem', array('methods' => 'GET', 'permission_callback' => '__return_true',
        'callback' => function (WP_REST_Request $req) {
            $tok = (string) $req->get_param('token');
            $h = eigod_read_token($tok, 'r');
            $used = 'eigod_used_' . md5($tok);
            if (!$h || get_transient($used)) return eigod_reply(false, 401);
            set_transient($used, 1, (EIGOD_LINK_MINUTES + 5) * 60);  // one use only
            eigod_grant($h);
            return eigod_reply(true);
        }));
});
