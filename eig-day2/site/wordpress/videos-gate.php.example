<?php
/**
 * EIG On-Demand video gate. Lives at  public_html/eigod-gate.php  (your site's top folder: many hosts, including this
 * one, refuse to run PHP inside wp-content/uploads).
 * The .htaccess in wp-content/uploads/eig-ondemand/videos/ sends every video request here.
 *   - gated = false in eigod-config.php: the file is served to anyone (test mode, same as before).
 *   - gated = true: the file is served only to a browser holding the signed eigod_access cookie (set by the access
 *     plugin after a verified Stripe payment, a restore-access link, or the shared partner link).
 * It doesn't load WordPress, so it stays fast. Settings come from /home/<account>/eigod-config.php (one level above
 * public_html).
 */
function deny($code = 403) { http_response_code($code); header('Cache-Control: no-store'); exit; }

// If the settings file is missing or broken the videos stay LOCKED (an open library is the worse mistake).
try { $cfg = is_file(__DIR__ . '/../eigod-config.php') ? include __DIR__ . '/../eigod-config.php' : false; } catch (\Throwable $e) { $cfg = false; }
if (!is_array($cfg)) deny(503);
$secret = isset($cfg['secret']) ? (string) $cfg['secret'] : '';

if (!empty($cfg['gated'])) {
    // 1. Verify the cookie: payload.hmac, payload = base64url(expiry.id)
    $tok = isset($_COOKIE['eigod_access']) ? $_COOKIE['eigod_access'] : '';
    $parts = explode('.', $tok);
    if (count($parts) !== 2 || !$secret) deny();
    list($payload, $sig) = $parts;
    if (!hash_equals(hash_hmac('sha256', $payload, $secret), $sig)) deny();
    $decoded = base64_decode(strtr($payload, '-_', '+/'));
    $expiry = (int) strtok($decoded, '.');
    if ($expiry < time()) deny();
    // a partner cookie (id starts with 'p') is only good while it matches the current partner_key
    $id = (string) substr($decoded, strlen((string) $expiry) + 1);
    if ($id !== '' && $id[0] === 'p') {
        $pk = isset($cfg['partner_key']) ? (string) $cfg['partner_key'] : '';
        if ($pk === '' || !hash_equals('p' . substr(hash('sha256', 'partner:' . $pk), 0, 15), $id)) deny();
    }
}

// 2. Resolve the requested file safely inside this folder
$rel  = isset($_GET['f']) ? $_GET['f'] : '';
$base = realpath(__DIR__ . '/wp-content/uploads/eig-ondemand/videos');
$path = realpath($base . '/' . $rel);
if (!$path || strpos($path, $base . DIRECTORY_SEPARATOR) !== 0 || !is_file($path)) deny(404);

$types = array('m3u8' => 'application/vnd.apple.mpegurl', 'ts' => 'video/mp2t', 'm4s' => 'video/iso.segment',
               'mp4' => 'video/mp4', 'vtt' => 'text/vtt', 'jpg' => 'image/jpeg', 'webp' => 'image/webp');
$ext = strtolower(pathinfo($path, PATHINFO_EXTENSION));
if (!isset($types[$ext])) deny(404);

header('Content-Type: ' . $types[$ext]);
header('Cache-Control: private, max-age=' . ($ext === 'm3u8' ? 300 : 604800));
header('X-Content-Type-Options: nosniff');

// 3. Hand the transfer back to the web server (fast, supports ranges) when available:
//    LiteSpeed (common on KnownHost): internal redirect.  Apache + mod_xsendfile: X-Sendfile.
if (isset($_SERVER['SERVER_SOFTWARE']) && stripos($_SERVER['SERVER_SOFTWARE'], 'litespeed') !== false) {
    header('X-LiteSpeed-Location: ' . str_replace($_SERVER['DOCUMENT_ROOT'], '', $path));
    exit;
}
header('Content-Length: ' . filesize($path));
readfile($path);
